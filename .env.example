# SupportAssistant örnek ortam değişkenleri
#
#   cp .env.example .env      (.env git'e girmez)
#
# .env yalnızca Development ortamında (dotnet run) otomatik yüklenir. Gerçek ortam değişkenleri
# .env'deki değerlerden önceliklidir; diğer ortamlarda yalnızca gerçek ortam değişkenleri kullanılır.
# API anahtarlarını asla koda veya appsettings.json'a yazmayın.

# --- Dil modeli -------------------------------------------------------------------------------
# OpenAI-uyumlu herhangi bir uç: llama.cpp llama-server, LM Studio, Ollama, OpenAI, Gemini...
# Model sunucusu başka bir makinedeyse localhost yerine o makinenin IP adresini yazın
# (ör. http://192.168.1.50:1234/v1 — örnek adres) ve sunucuyu --host 0.0.0.0 ile başlatın. Ayrıntı: README.
Llm__BaseUrl=http://localhost:1234/v1
# Yerel sunucular anahtarı yok sayar; bulut sağlayıcıda kendi anahtarınızı yazın.
Llm__ApiKey=local
# Tek model sunan sunucular (llama.cpp) bu adı yok sayar; loglarda ve raporlarda görünür.
Llm__ChatModel=gemma-4-26b-a4b-it
# Gemma 4 + llama.cpp için düşünme modunu kapatır (değerlendirmede aynı doğruluk, ~7 kat hızlı).
# chat_template_kwargs alanını tanımayan sağlayıcılarda (OpenAI, Gemini) bu satırı silin.
Llm__EnableThinking=false
Llm__Temperature=0
Llm__Seed=42
Llm__MaxOutputTokens=4096
Llm__TimeoutSeconds=120
# false: JSON şeması response_format yerine prompt içinde tarif edilir (json_schema desteklemeyen sunucular için).
Llm__UseJsonSchema=true

# --- Embedding -------------------------------------------------------------------------------
# OpenAI-uyumlu /v1/embeddings ucu. Boş bırakılırsa arama yalnızca BM25 (anahtar kelime) ile çalışır.
# Başka bir makinedeyse burada da localhost yerine IP adresini yazın (ör. http://192.168.1.50:1235/v1).
Embeddings__BaseUrl=http://localhost:1235/v1
Embeddings__ApiKey=local
Embeddings__Model=bge-m3
# bge-m3 önek istemez. EmbeddingGemma / e5 gibi görev öneki isteyen modeller için doldurun;
# {title} doküman başlığıyla değiştirilir. Örnek (EmbeddingGemma):
#   Embeddings__QueryPrefix=task: search result | query:
#   Embeddings__DocumentPrefix=title: {title} | text:
Embeddings__QueryPrefix=
Embeddings__DocumentPrefix=

# --- Arama ve "bilgi yok" eşikleri -------------------------------------------------------------
# Modele verilen bölüm sayısı.
Retrieval__TopK=8
# Kapı 1: en iyi kosinüs benzerliği VEYA kelime kapsamı bu eşikleri geçmezse model çağrılmaz.
Retrieval__MinDenseScore=0.55
Retrieval__MinLexicalCoverage=0.5

# --- Veri -------------------------------------------------------------------------------------
KnowledgeBase__Path=knowledge-base
ConnectionStrings__DefaultConnection=Data Source=supportassistant.db

# --- Güvenlik ---------------------------------------------------------------------------------
# POST /v1/documents/reindex için yönetici anahtarı; istekte X-Admin-Key başlığıyla gönderilir.
# Boş bırakılırsa uç kapalıdır (403). Açılıştaki indeksleme bundan etkilenmez.
# Uzun ve rastgele bir değer kullanın, örn.: openssl rand -hex 32
Security__AdminApiKey=
# POST /v1/questions için istemci (IP) başına dakikalık soru sınırı; 0 sınırı kapatır.
RateLimiting__QuestionsPerMinute=30
# Kabul edilen en büyük istek gövdesi (bayt); aşan istek okunmadan 413 alır. 0 sınırı kapatır.
Security__MaxRequestBodyBytes=16384

# İsteğe bağlı: MediatR 13+ ticari lisans anahtarı. Yoksa açılışta yalnızca bir uyarı loglanır.
# MEDIATR_LICENSE_KEY=
